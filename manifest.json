{
  "manifest_version": 3,
  "name": "Chat Capture for Teams",
  "version": "1.1",
  "description": "Rola a conversa do Teams do início ao fim e salva tudo em .html. Não afiliado à Microsoft.",
  "permissions": ["scripting", "activeTab", "storage"],
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_icon": { "16": "icon16.png", "48": "icon48.png" }, "default_title": "Capturar conversa do Teams", "default_popup": "popup.html" }
}
